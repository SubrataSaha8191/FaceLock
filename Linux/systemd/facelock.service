[Unit]
Description=FaceLock Biometric Authentication Service
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/facelock/Service/main.py
WorkingDirectory=/opt/facelock
Restart=on-failure
RestartSec=5
User=root
Group=root
Environment=PYTHONPATH=/opt/facelock

[Install]
WantedBy=multi-user.target
